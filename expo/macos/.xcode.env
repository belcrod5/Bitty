export NODE_BINARY=$(command -v node)

# ビルドスタンプ(設定画面に表示)。バンドルフェーズがこのファイルを source した後に
# export:embed を実行するため、babel が EXPO_PUBLIC_* をバンドルへインライン化できる。
BITTY_GIT_SHA=$(git -C "${PROJECT_DIR:-.}" rev-parse --short HEAD 2>/dev/null || echo unknown)
if [ -n "$(git -C "${PROJECT_DIR:-.}" status --porcelain 2>/dev/null)" ]; then
  BITTY_GIT_SHA="${BITTY_GIT_SHA}+dirty"
fi
export EXPO_PUBLIC_BUILD_STAMP="$(date '+%Y-%m-%d %H:%M:%S') (${BITTY_GIT_SHA})"
