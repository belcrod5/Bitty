new file mode 100644
index 0000000..7759c09
--- /dev/null
+++ b/node_modules/expo-secure-store/ios/SecureStoreMacOSKeychain.swift
@@ -0,0 +1,88 @@
+#if os(macOS)
+import Foundation
+import Security
+
+enum SecureStoreMacOSKeychain {
+  enum MigrationResult {
+    case missing
+    case value(Data)
+    case failure(OSStatus)
+  }
+
+  static func migrateItem(
+    canonicalQuery: [String: Any],
+    legacyQuery: [String: Any]
+  ) -> MigrationResult {
+    switch read(query: canonicalQuery) {
+    case .value(let value):
+      SecItemDelete(legacyQuery as CFDictionary)
+      return .value(value)
+    case .failure(let status):
+      return .failure(status)
+    case .missing:
+      break
+    }
+
+    let legacyValue: Data
+    switch read(query: legacyQuery) {
+    case .value(let value):
+      legacyValue = value
+    case .missing:
+      return .missing
+    case .failure(let status):
+      return .failure(status)
+    }
+
+    guard let canonicalAccount = canonicalQuery[kSecAttrAccount as String] else {
+      return .failure(errSecParam)
+    }
+    let status = SecItemUpdate(
+      legacyQuery as CFDictionary,
+      [kSecAttrAccount as String: canonicalAccount] as CFDictionary
+    )
+
+    switch status {
+    case errSecSuccess:
+      return .value(legacyValue)
+    case errSecDuplicateItem:
+      switch read(query: canonicalQuery) {
+      case .value(let value):
+        SecItemDelete(legacyQuery as CFDictionary)
+        return .value(value)
+      case .missing:
+        return .failure(status)
+      case .failure(let readStatus):
+        return .failure(readStatus)
+      }
+    default:
+      return .failure(status)
+    }
+  }
+
+  static func deleteItems(matching queries: [[String: Any]]) {
+    for query in queries {
+      SecItemDelete(query as CFDictionary)
+    }
+  }
+
+  private static func read(query: [String: Any]) -> MigrationResult {
+    var searchQuery = query
+    searchQuery[kSecMatchLimit as String] = kSecMatchLimitOne
+    searchQuery[kSecReturnData as String] = kCFBooleanTrue
+
+    var item: CFTypeRef?
+    let status = SecItemCopyMatching(searchQuery as CFDictionary, &item)
+    switch status {
+    case errSecSuccess:
+      guard let value = item as? Data else {
+        return .failure(errSecInternalError)
+      }
+      return .value(value)
+    case errSecItemNotFound:
+      return .missing
+    default:
+      return .failure(status)
+    }
+  }
+}
+#endif
