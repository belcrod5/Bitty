+  private static func defaultDocumentDirectory() -> URL? {
+    #if os(macOS)
+    guard let applicationSupportDirectory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+      return nil
+    }
+    let bundleIdentifier = Bundle.main.bundleIdentifier ?? ProcessInfo.processInfo.processName
+    let appDirectory = applicationSupportDirectory.appendingPathComponent(bundleIdentifier, isDirectory: true)
+
+    if FileManager.default.fileExists(atPath: appDirectory.path),
+       !directoryIsEmpty(appDirectory) {
+      return appDirectory
+    }
+
+    let appName = Bundle.main.object(forInfoDictionaryKey: "CFBundleName") as? String
+      ?? ProcessInfo.processInfo.processName
+    let regularLegacyDirectory = applicationSupportDirectory.appendingPathComponent(appName, isDirectory: true)
+    let sandboxLegacyDirectory = FileManager.default.homeDirectoryForCurrentUser
+      .appendingPathComponent("Library/Containers/\(bundleIdentifier)/Data/Library/Application Support", isDirectory: true)
+      .appendingPathComponent(appName, isDirectory: true)
+    let legacyDirectories = [sandboxLegacyDirectory, regularLegacyDirectory]
+      .filter { legacyDirectory in
+        legacyDirectory.standardizedFileURL != appDirectory.standardizedFileURL
+          && directoryHasContents(legacyDirectory)
+      }
+      .sorted { latestModificationDate(in: $0) > latestModificationDate(in: $1) }
+
+    if let legacyDirectory = legacyDirectories.first {
+      if FileManager.default.fileExists(atPath: appDirectory.path) {
+        if rmdir(appDirectory.path) != 0 {
+          if FileManager.default.fileExists(atPath: appDirectory.path) {
+            return directoryHasContents(appDirectory) ? appDirectory : legacyDirectory
+          }
+        }
+      }
+      let stagingDirectory = applicationSupportDirectory
+        .appendingPathComponent(".\(bundleIdentifier).migration-\(UUID().uuidString)", isDirectory: true)
+      do {
+        try FileManager.default.copyItem(at: legacyDirectory, to: stagingDirectory)
+        if FileManager.default.fileExists(atPath: appDirectory.path) {
+          try? FileManager.default.removeItem(at: stagingDirectory)
+          return directoryHasContents(appDirectory) ? appDirectory : legacyDirectory
+        }
+        try FileManager.default.moveItem(at: stagingDirectory, to: appDirectory)
+        return appDirectory
+      } catch {
+        try? FileManager.default.removeItem(at: stagingDirectory)
+        return directoryHasContents(appDirectory) ? appDirectory : legacyDirectory
+      }
+    }
+
+    do {
+      try FileManager.default.createDirectory(at: appDirectory, withIntermediateDirectories: true)
+      return appDirectory
+    } catch {
+      return nil
+    }
+    #else
+    return FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first
+    #endif
+  }
+
+  #if os(macOS)
+  private static func directoryIsEmpty(_ directory: URL) -> Bool {
+    var isDirectory = ObjCBool(false)
+    guard FileManager.default.fileExists(atPath: directory.path, isDirectory: &isDirectory),
+          isDirectory.boolValue,
+          let contents = try? FileManager.default.contentsOfDirectory(atPath: directory.path) else {
+      return false
+    }
+    return contents.isEmpty
+  }
+
+  private static func directoryHasContents(_ directory: URL) -> Bool {
+    guard let contents = try? FileManager.default.contentsOfDirectory(atPath: directory.path) else {
+      return false
+    }
+    return !contents.isEmpty
+  }
+
+  private static func latestModificationDate(in directory: URL) -> Date {
+    let keys: [URLResourceKey] = [.contentModificationDateKey]
+    guard let enumerator = FileManager.default.enumerator(
+      at: directory,
+      includingPropertiesForKeys: keys,
+      options: [.skipsPackageDescendants]
+    ) else {
+      return .distantPast
+    }
+    var latestDate = Date.distantPast
+    for case let item as URL in enumerator {
+      if let modificationDate = try? item.resourceValues(forKeys: Set(keys)).contentModificationDate,
+         modificationDate > latestDate {
+        latestDate = modificationDate
+      }
+    }
+    return latestDate
+  }
+  #endif
